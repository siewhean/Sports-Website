# Copy to .env.oci on the OCI VM. Replace every CHANGE_ME value and replace
# the example hostname/domain values with the real staging DNS name and its
# registrable-domain boundary (for example, staging.matchday.example and
# matchday.example).
# Use URL-safe passwords because the connection strings are assembled by Compose.
OCI_PUBLIC_HOSTNAME=staging.example.com
OCI_COOKIE_SITE=https://example.com
CANDIDATE_SHA=CHANGE_ME_40_CHARACTER_SHA
# deploy.sh sets this for each rollout.
BUILD_TIMESTAMP=
APP_ENV=staging
NODE_ENV=production
API_ALLOWED_ORIGINS=https://${OCI_PUBLIC_HOSTNAME}
MATCHDAY_PUBLIC_ORIGIN=https://${OCI_PUBLIC_HOSTNAME}
API_TRUSTED_PROXIES=172.30.0.10
# Gate D public-load allowance; staging-only and never copy to production.
GATE_D_STAGING_PUBLIC_RATE_LIMIT_MAX=10000
SCORING_SESSION_SEAL_KEY=CHANGE_ME_BASE64URL_32_BYTE_SCORING_KEY

POSTGRES_DB=matchday
POSTGRES_USER=matchday
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_URL_SAFE_REDIS_PASSWORD

DEEP_HEALTH_TOKEN=CHANGE_ME_32_OR_MORE_CHARACTERS
IDENTITY_ASSURANCE_POLICY=off
IDENTITY_CSRF_HMAC_SECRET=CHANGE_ME_32_OR_MORE_CHARACTERS
IDENTITY_PROVIDER=oidc
IDENTITY_OIDC_ISSUER=https://CHANGE_ME_OIDC_ISSUER
IDENTITY_OIDC_CLIENT_ID=CHANGE_ME
IDENTITY_OIDC_CLIENT_SECRET=CHANGE_ME_16_OR_MORE_CHARACTERS
IDENTITY_OIDC_CALLBACK_URI=https://${OCI_PUBLIC_HOSTNAME}/api/v1/identity/callback
IDENTITY_FLOW_SEAL_KEY=CHANGE_ME_BASE64URL_32_BYTE_KEY
IDENTITY_PROVIDER_EVENT_HMAC_SECRET=CHANGE_ME_32_OR_MORE_CHARACTERS
IDENTITY_HOSTED_RECOVERY_URL=https://${OCI_PUBLIC_HOSTNAME}/recover
IDENTITY_COOKIE_SITE=${OCI_COOKIE_SITE}
IDENTITY_POST_AUTH_REDIRECT_URIS=https://${OCI_PUBLIC_HOSTNAME}/organiser

SCORING_ACCESS_RATE_LIMIT_HMAC_KEYRING={"primary":{"version":"v2","secret":"CHANGE_ME_DIFFERENT_32_OR_MORE_CHARACTERS"},"verificationOnly":[]}
# Set this only when the keyring retains a v1 verification key during rotation.
SCORING_ACCESS_RATE_LIMIT_LEGACY_V1_MATERIAL_COMMITMENT=
SCORING_ACCESS_RATE_LIMIT_HMAC_SECRET=CHANGE_ME_LEGACY_RATE_LIMIT_SECRET_32_OR_MORE_CHARACTERS
SCORING_ACCESS_FALLBACK_CODE_HMAC_SECRET=CHANGE_ME_ANOTHER_32_OR_MORE_CHARACTERS
EDGE_CACHE_PURGE_ENDPOINT=https://CHANGE_ME_EDGE_PURGE_HOST/purge
EDGE_CACHE_PURGE_BEARER_TOKEN=CHANGE_ME_EDGE_PURGE_TOKEN_32_OR_MORE_CHARACTERS
DB_POOL_MAX=10
LOG_LEVEL=info
OTEL_ENABLED=false
SMTP_HOST=CHANGE_ME_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=true
SMTP_FROM=Matchday <no-reply@${OCI_PUBLIC_HOSTNAME}>
