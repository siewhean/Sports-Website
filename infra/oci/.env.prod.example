# Dedicated production environment configuration for Matchday.
# Copy to .env.prod on the OCI VM and ensure permissions are chmod 600.
# Do not reuse staging credentials or staging databases.

OCI_PUBLIC_HOSTNAME=matchday.poladex.shop
# Caddy site addresses (see infra/oci/Caddyfile). OCI_PROD_HOSTNAME must equal OCI_PUBLIC_HOSTNAME;
# OCI_STAGING_HOSTNAME is the drill/staging stack served by the same Caddy. Moving domains = change these
# values (plus the origins below) and recreate the Caddy container.
OCI_PROD_HOSTNAME=matchday.poladex.shop
OCI_STAGING_HOSTNAME=c5-drill.poladex.shop
# Image source for deploy-prod.sh (built and pushed by CI; see .github/workflows/ci.yml job "images").
# Optional override (read from the deploy shell environment by deploy-prod.sh; default ghcr.io/siewhean):
# MATCHDAY_IMAGE_REGISTRY=ghcr.io/siewhean
OCI_COOKIE_SITE=https://matchday.poladex.shop
CANDIDATE_SHA=
BUILD_TIMESTAMP=
APP_ENV=production
NODE_ENV=production
API_ALLOWED_ORIGINS=https://matchday.poladex.shop
MATCHDAY_PUBLIC_ORIGIN=https://matchday.poladex.shop
API_TRUSTED_PROXIES=172.31.0.10,172.31.0.12

# Production Rate Limits
GATE_D_STAGING_PUBLIC_RATE_LIMIT_MAX=
# Per-client limit for anonymous GET /api/v1/public/* (default 600/min) and
# concurrent public live-update streams per client IP per API instance (default 16).
API_PUBLIC_READ_RATE_LIMIT_MAX=600
API_PUBLIC_SSE_MAX_STREAMS_PER_CLIENT=16
# Shared by the API (env_file) and the web BFF (compose interpolation): the BFF
# HMAC-signs the end-user IP it forwards so API rate limits are per client.
# Required in production; 32+ bytes; must differ from every other secret here.
MATCHDAY_CLIENT_IP_SECRET=CHANGE_ME_PROD_CLIENT_IP_FORWARDING_SECRET_32_CHARS
SCORING_SESSION_SEAL_KEY=CHANGE_ME_BASE64URL_32_BYTE_PROD_SCORING_KEY

POSTGRES_DB=matchday_prod
POSTGRES_USER=matchday_prod
POSTGRES_PASSWORD=CHANGE_ME_URL_SAFE_PROD_POSTGRES_PASSWORD
REDIS_PASSWORD=CHANGE_ME_URL_SAFE_PROD_REDIS_PASSWORD

DEEP_HEALTH_TOKEN=CHANGE_ME_32_OR_MORE_CHARACTERS_PROD
# Allowed: off | mfa | phishing_resistant (anything else, e.g. "strict", stops the API at boot).
# `mfa` requires a multi-factor login; do not set `off` in production.
IDENTITY_ASSURANCE_POLICY=mfa
IDENTITY_CSRF_HMAC_SECRET=CHANGE_ME_32_OR_MORE_CHARACTERS_PROD
IDENTITY_PROVIDER=oidc
IDENTITY_OIDC_ISSUER=https://CHANGE_ME_OIDC_ISSUER
IDENTITY_OIDC_CLIENT_ID=CHANGE_ME
IDENTITY_OIDC_CLIENT_SECRET=CHANGE_ME_16_OR_MORE_CHARACTERS_PROD
IDENTITY_OIDC_CALLBACK_URI=https://${OCI_PUBLIC_HOSTNAME}/api/v1/identity/callback
IDENTITY_FLOW_SEAL_KEY=CHANGE_ME_BASE64URL_32_BYTE_KEY_PROD
IDENTITY_PROVIDER_EVENT_HMAC_SECRET=CHANGE_ME_32_OR_MORE_CHARACTERS_PROD
IDENTITY_HOSTED_RECOVERY_URL=https://CHANGE_ME_PROVIDER_HOST/RECOVERY_PATH
IDENTITY_COOKIE_SITE=${OCI_COOKIE_SITE}
IDENTITY_POST_AUTH_REDIRECT_URIS=https://${OCI_PUBLIC_HOSTNAME}/organiser

SCORING_ACCESS_RATE_LIMIT_HMAC_KEYRING={"primary":{"version":"v2","secret":"CHANGE_ME_PROD_32_OR_MORE_CHARACTERS"},"verificationOnly":[]}
SCORING_ACCESS_RATE_LIMIT_LEGACY_V1_MATERIAL_COMMITMENT=
SCORING_ACCESS_RATE_LIMIT_HMAC_SECRET=CHANGE_ME_PROD_RATE_LIMIT_SECRET_32_CHARACTERS
SCORING_ACCESS_FALLBACK_CODE_HMAC_SECRET=CHANGE_ME_PROD_FALLBACK_CODE_HMAC_SECRET
EDGE_CACHE_PURGE_ENDPOINT=https://CHANGE_ME_EDGE_PURGE_HOST/purge
EDGE_CACHE_PURGE_BEARER_TOKEN=CHANGE_ME_PROD_EDGE_PURGE_TOKEN_32_CHARACTERS
DB_POOL_MAX=10
LOG_LEVEL=info
OTEL_ENABLED=false
SMTP_HOST=CHANGE_ME_PROD_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_USER=
SMTP_AUTH_PASS=
SMTP_FROM=Matchday <no-reply@${OCI_PUBLIC_HOSTNAME}>

# Optional G3 collector: keep disabled until a separately authorized rollout.
# Application processes receive no provider credential. This endpoint is the only
# production HTTP exception; generic/external exporters must use HTTPS.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_COLLECTOR_EXTERNAL_ENDPOINT=https://provider-ingest.example.com
# Token reference: /etc/matchday/secrets/otel-bearer-token (root-owned mode 600,
# outside Git; mounted only into the collector). Never place its contents here.

# Sentry error tracking (docs/operations/SENTRY.md). Blank = fully disabled, no network calls.
# SENTRY_DSN is used by api, worker and the web server; NEXT_PUBLIC_SENTRY_DSN (same value)
# is inlined into the browser bundle at build time and sent via the same-origin /api/monitoring tunnel.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Database backups (infra/oci/backup/, docs/operations/BACKUP_RESTORE.md) ---
# Off-host copies go to OCI Object Storage via the S3-compatible API (path-style).
# Endpoint: https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
# Access key / secret = an OCI "Customer Secret Key" of a dedicated least-privilege user.
BACKUP_S3_ENDPOINT=https://CHANGE_ME_NAMESPACE.compat.objectstorage.ap-singapore-1.oraclecloud.com
BACKUP_S3_REGION=ap-singapore-1
BACKUP_S3_BUCKET=CHANGE_ME_BACKUP_BUCKET
BACKUP_S3_PREFIX=postgres
BACKUP_S3_ACCESS_KEY_ID=CHANGE_ME_CUSTOMER_SECRET_KEY_ID
BACKUP_S3_SECRET_ACCESS_KEY=CHANGE_ME_CUSTOMER_SECRET_KEY_SECRET
# age PUBLIC key(s), comma-separated. The matching PRIVATE key never lives on this VM.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME_PUBLIC_KEY_FROM_AGE_KEYGEN
# Fail-closed: leave at 0 so an empty recipient stops the backup instead of uploading plaintext.
BACKUP_ALLOW_PLAINTEXT=0
# Retention: 14 dailies + 8 weeklies + 10 pre-migration snapshots (free tier is 20 GB total).
BACKUP_RETAIN_DAILY=14
BACKUP_RETAIN_WEEKLY=8
BACKUP_RETAIN_PREMIGRATION=10
# Backup run fails if the bucket prefix exceeds this many bytes (15 GiB).
BACKUP_MAX_TOTAL_BYTES=16106127360
# Optional dead-man's-switch URL (Better Stack heartbeat / healthchecks.io); pinged on success,
# <url>/fail on failure.
BACKUP_HEARTBEAT_URL=
# Host directory for dumps/status (must exist, owned by the uid below) and the container uid/gid.
MATCHDAY_BACKUP_DIR=/var/lib/matchday/backups
MATCHDAY_BACKUP_UID=1000
MATCHDAY_BACKUP_GID=1000

# Internal schedule-maintenance route (x-matchday-maintenance-token). Blank = route refuses all calls.
# 32+ characters, must differ from DEEP_HEALTH_TOKEN and every other secret.
MATCHDAY_MAINTENANCE_TOKEN=

# Stripe billing (blank = checkout disabled). Enable the checkout.session.completed and
# checkout.session.async_payment_succeeded / async_payment_failed webhook events in Stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_EVENT_PASS=
STRIPE_PRICE_ID_ORGANISER_PRO=
STRIPE_PRICE_ID_AI_TOPUP=
STRIPE_API_TIMEOUT_MS=10000
