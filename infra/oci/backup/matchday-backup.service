# Install: sudo cp matchday-backup.service matchday-backup.timer /etc/systemd/system/
#          sudo systemctl daemon-reload && sudo systemctl enable --now matchday-backup.timer
# Adjust WorkingDirectory if the repository is not checked out at /opt/matchday/oci-src.
[Unit]
Description=MATCHDAY nightly Postgres backup to OCI Object Storage
Wants=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/matchday/oci-src
# Use the backup image of the currently deployed release: deploy-prod.sh records it as ACTIVE_SHA.
# (A fixed placeholder tag would make compose look for an image that does not exist.)
EnvironmentFile=/var/lib/matchday/deploy/active-slot.env
Environment=BUILD_TIMESTAMP=backup
ExecStart=/bin/sh -c 'CANDIDATE_SHA="$ACTIVE_SHA" exec /usr/bin/docker compose --env-file infra/oci/.env.prod -f infra/oci/compose.prod.yaml --profile backup run --rm --no-deps backup backup'
TimeoutStartSec=1h
# A non-zero exit marks the unit failed (systemctl --failed, journalctl -u matchday-backup).
