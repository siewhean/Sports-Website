  "invalid_graph_cases": [
    {
      "id": "duplicate-stage-id",
      "expected_issue": "duplicate_stage_id",
      "graph": {
        "entryCount": 2,
        "stages": [
          { "id": "final", "order": 1, "matchIds": ["m1"] },
          { "id": "final", "order": 2, "matchIds": [] }
        ],
        "matches": [
          {
            "id": "m1",
            "stageId": "final",
            "order": 1,
            "home": { "type": "entry_seed", "seed": 1 },
            "away": { "type": "entry_seed", "seed": 2 }
          }
        ],
        "terminalMatchIds": ["m1"]
      }
    },
    {
      "id": "unknown-match-source",
      "expected_issue": "unknown_match",
      "graph": {
        "entryCount": 2,
        "stages": [{ "id": "final", "order": 1, "matchIds": ["m1"] }],
        "matches": [
          {
            "id": "m1",
            "stageId": "final",
            "order": 1,
            "home": { "type": "winner", "matchId": "missing" },
            "away": { "type": "entry_seed", "seed": 2 }
          }
        ],
        "terminalMatchIds": ["m1"]
      }
    },
    {
      "id": "dependency-cycle",
      "expected_issue": "cycle",
      "graph": {
        "entryCount": 2,
        "stages": [{ "id": "finals", "order": 1, "matchIds": ["m1", "m2"] }],
        "matches": [
          {
            "id": "m1",
            "stageId": "finals",
            "order": 1,
            "home": { "type": "winner", "matchId": "m2" },
            "away": { "type": "entry_seed", "seed": 1 }
          },
          {
            "id": "m2",
            "stageId": "finals",
            "order": 2,
            "home": { "type": "winner", "matchId": "m1" },
            "away": { "type": "entry_seed", "seed": 2 }
          }
        ],
        "terminalMatchIds": []
      }
    }
