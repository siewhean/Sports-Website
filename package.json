{
  "name": "sports-competition-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @matchday/api --filter @matchday/web dev",
    "dev:web": "pnpm --filter @matchday/web dev",
    "dev:api": "pnpm --filter @matchday/api dev",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"packages/**/*.ts\" \"apps/worker/**/*.ts\" --max-warnings=0 && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:performance": "pnpm --filter @matchday/scheduler test:performance",
    "test:e2e": "pnpm --filter @matchday/web test:e2e",
    "test:e2e:phase2:real": "pnpm --filter @matchday/api exec tsx scripts/run-phase-2-real-e2e.ts",
    "test:e2e:phase4:real": "pnpm --filter @matchday/api exec tsx scripts/run-phase-4-real-e2e-v2.ts",
    "test:a11y": "pnpm --filter @matchday/web test:a11y",
    "test:visual": "pnpm --filter @matchday/web test:visual",
    "validate:fixtures": "node scripts/validate-canonical-fixtures.mjs",
    "validate:phase2": "node scripts/validate-phase-2-fixtures.mjs",
    "validate:phase3": "node scripts/validate-phase-3-fixtures.mjs",
    "validate:phase4": "node scripts/validate-phase-4-schedule-fixtures.mjs",
    "db:migrate": "pnpm --filter @matchday/database db:migrate",
    "db:migrate:check": "pnpm --filter @matchday/database db:migrate:check",
    "backup:verify": "bash scripts/verify-backup-restore.sh",
    "ci:assert-clean-outputs": "node scripts/assert-clean-workspace-outputs.mjs",
    "deploy:manifest": "node scripts/generate-deployment-manifest.mjs",
    "asset-delivery:verify:origin": "node scripts/verify-asset-delivery.mjs",
    "openapi:generate": "pnpm --filter @matchday/api openapi:generate",
    "openapi:check": "pnpm --filter @matchday/api openapi:check",
    "dependencies:known-advisories": "node scripts/assert-known-production-advisories.mjs",
    "dependencies:audit": "pnpm dependencies:known-advisories && pnpm audit --prod --audit-level moderate",
    "secrets:scan": "bash scripts/scan-secrets.sh",
    "qa:gate-b:runner-self-test": "node scripts/test-gate-b-evidence.mjs",
    "qa:gate-b:external-self-test": "node scripts/test-gate-b-external-evidence.mjs",
    "qa:gate-b:external": "node scripts/verify-gate-b-external-evidence.mjs",
    "qa:gate-b:local": "node scripts/run-gate-b-local.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:performance && pnpm validate:fixtures && pnpm validate:phase2 && pnpm validate:phase3 && pnpm validate:phase4 && pnpm openapi:check && pnpm dependencies:audit && pnpm secrets:scan && pnpm build && pnpm deploy:manifest && pnpm asset-delivery:verify:origin",
    "setup:workspace": "node scripts/setup-workspace.mjs"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "4.1.10"
  }
}
