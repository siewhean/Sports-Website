{
  "name": "sports-competition-platform",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @matchday/api --filter @matchday/web dev",
    "dev:web": "pnpm --filter @matchday/web dev",
    "dev:api": "pnpm --filter @matchday/api dev",
    "build": "turbo run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"packages/**/*.ts\" \"apps/worker/**/*.ts\" --max-warnings=0 && turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration --concurrency=1",
    "test:e2e": "pnpm --filter @matchday/web test:e2e && pnpm test:e2e:phase4:real",
    "test:e2e:phase2:real": "pnpm --filter @matchday/api exec tsx scripts/run-phase-2-real-e2e.ts",
    "test:e2e:gate-c-access:real": "pnpm --filter @matchday/api exec tsx scripts/run-gate-c-access-e2e.ts",
    "evidence:gate-c-access:run": "node scripts/run-gate-c-access-ledger.mjs",
    "test:evidence:gate-c-access": "node --test scripts/run-gate-c-access-ledger.test.mjs",
    "test:e2e:gate-c-c2:real": "pnpm --filter @matchday/api exec tsx scripts/run-gate-c-c2-e2e.ts",
    "evidence:gate-c-c2:run": "node scripts/run-gate-c-c2-ledger.mjs",
    "test:evidence:gate-c-c2": "node --test scripts/run-gate-c-c2-ledger.test.mjs",
    "test:e2e:gate-c-c3:real": "pnpm --filter @matchday/api exec tsx scripts/run-gate-c-c3-e2e.ts",
    "evidence:gate-c-c3:run": "node scripts/run-gate-c-c3-ledger.mjs",
    "test:evidence:gate-c-c3": "node --test scripts/run-gate-c-c3-ledger.test.mjs",
    "test:gate-c-c5:lifecycle": "pnpm --filter @matchday/api exec tsx scripts/run-gate-c-c5-lifecycle.ts",
    "evidence:gate-c-c5:execute": "node scripts/run-gate-c-c5-ledger.mjs",
    "evidence:gate-c-c5:run": "node scripts/run-gate-c-c5-ledger.mjs",
    "evidence:gate-c-c5:prepare-review": "node scripts/run-gate-c-c5-ledger.mjs --prepare-review",
    "evidence:gate-c-c5:finalize": "node scripts/run-gate-c-c5-ledger.mjs --finalize",
    "test:evidence:gate-c-c5": "node --test scripts/run-gate-c-c5-ledger.test.mjs",
    "test:e2e:phase4:real": "pnpm --filter @matchday/api exec tsx scripts/run-phase-4-real-e2e.ts",
    "test:a11y": "pnpm --filter @matchday/web test:a11y",
    "test:visual": "pnpm --filter @matchday/web test:visual",
    "validate:fixtures": "node scripts/validate-canonical-fixtures.mjs",
    "validate:phase2": "node scripts/validate-phase-2-fixtures.mjs",
    "validate:phase3": "node scripts/validate-phase-3-fixtures.mjs",
    "validate:phase4": "node scripts/validate-phase-4-schedule-fixtures.mjs",
    "evidence:phase4:validate": "node scripts/validate-browser-gate-evidence.mjs",
    "evidence:phase4:write": "node scripts/write-browser-gate-evidence.mjs",
    "test:evidence:phase4": "node --test scripts/write-browser-gate-evidence.test.mjs",
    "db:migrate": "pnpm --filter @matchday/database db:migrate",
    "db:migrate:check": "pnpm --filter @matchday/database db:migrate:check",
    "backup:verify": "bash scripts/verify-backup-restore.sh",
    "ci:assert-clean-outputs": "node scripts/assert-clean-workspace-outputs.mjs",
    "deploy:manifest": "node scripts/generate-deployment-manifest.mjs",
    "asset-delivery:verify:origin": "node scripts/verify-asset-delivery.mjs",
    "openapi:generate": "pnpm --filter @matchday/api openapi:generate",
    "openapi:check": "pnpm --filter @matchday/api openapi:check",
    "dependencies:audit": "pnpm audit --prod --audit-level moderate",
    "secrets:scan": "bash scripts/scan-secrets.sh",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:evidence:phase4 && pnpm test:evidence:gate-c-access && pnpm test:evidence:gate-c-c2 && pnpm test:evidence:gate-c-c3 && pnpm test:evidence:gate-c-c5 && pnpm test && pnpm validate:fixtures && pnpm validate:phase2 && pnpm validate:phase3 && pnpm validate:phase4 && pnpm openapi:check && pnpm dependencies:audit && pnpm secrets:scan && pnpm build && pnpm deploy:manifest && pnpm asset-delivery:verify:origin",
    "setup:workspace": "node scripts/setup-workspace.mjs"
  },
  "pnpm": {
    "overrides": {
      "@fastify/swagger-ui>@fastify/static": "10.1.2",
      "json-schema-resolver>fast-uri": "3.1.5",
      "fastify>find-my-way": "9.7.0",
      "minimatch@10.2.5>brace-expansion": "5.0.9",
      "postcss": "8.5.23",
      "next>sharp": "0.35.3"
    }
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "eslint": "9.39.5",
    "prettier": "3.9.5",
    "turbo": "2.10.5",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "4.1.10"
  }
}
