# Public canonical origin. Required before deployment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hosted environments: use a PostgreSQL connection string.
# DATABASE_URL=postgresql://user:password@host:5432/competition_studio
# Set DATABASE_SSL=disable only for a trusted local PostgreSQL connection.
DATABASE_SSL=require
DATABASE_POOL_MAX=5

# Self-contained local development fallback. Ignored when DATABASE_URL is set.
DATABASE_PATH=.data/competition-studio.sqlite
DB_AUTO_MIGRATE=true

SESSION_COOKIE_NAME=competition_studio_session
SESSION_TTL_DAYS=30

# Optional explicit demo organizer. db:seed creates only sport records unless both credentials are set.
# DEMO_USER_EMAIL=organizer@example.com
# DEMO_USER_PASSWORD=Choose-A-Local-Password-2026
# DEMO_USER_NAME=Demo Organizer
# ALLOW_DEMO_SEED=false
