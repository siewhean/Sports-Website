APP_ENV=local
API_HOST=127.0.0.1
API_PORT=4000
API_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
API_TRUSTED_PROXIES=
# Server-only API origin used by SSR and same-origin backend-for-frontend routes.
# Organiser reads forward only the named session cookie. The API must use the web hostname; localhost/127.0.0.1/::1 are treated as equivalent only for local loopback development.
MATCHDAY_API_BASE_URL=http://127.0.0.1:4000
# Server-only key used to seal match-scoped scoring credentials in a host-only HttpOnly cookie.
# Base64url encoding of exactly 32 random bytes. Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
SCORING_SESSION_SEAL_KEY=
# `demo` explicitly enables deterministic organiser/scoring fixtures for local visual/E2E runs only; deployed environments use `api`.
MATCHDAY_PHASE2_DATA_MODE=api
# Typed deployment override for the canonical /score route. Invalid values fail safe to the registry default (true).
MATCHDAY_FEATURE_SCORING_PHASE2_ROUTE=true
DATABASE_URL=postgres://matchday:matchday@127.0.0.1:5432/matchday
REDIS_URL=redis://127.0.0.1:6379
LOG_LEVEL=info
# Required outside local/test. Generate at least 32 random characters.
DEEP_HEALTH_TOKEN=
# Required outside local/test. Generate at least 32 random characters; never expose it to browsers.
IDENTITY_CSRF_HMAC_SECRET=
# Dedicated server-only HMAC secret for scoring credential and client-IP rate-limit fingerprints.
# Required outside local/test. Generate at least 32 random characters and do not reuse another application secret.
SCORING_ACCESS_RATE_LIMIT_HMAC_SECRET=
# Dedicated server-only HMAC secret for low-entropy 12-digit scoring fallback codes.
# Use a different secret from token, session and rate-limit hashing keys.
SCORING_ACCESS_FALLBACK_CODE_HMAC_SECRET=
# Worker-only and required in staging/production. Provider-neutral HTTPS purge bridge and a secret of at least 32 bytes.
EDGE_CACHE_PURGE_ENDPOINT=
EDGE_CACHE_PURGE_BEARER_TOKEN=
# `disabled` is permitted only for local/test fixtures. Staging and production require `oidc`.
IDENTITY_PROVIDER=disabled
# OIDC values are required when IDENTITY_PROVIDER=oidc. The issuer must exactly match provider discovery metadata.
IDENTITY_OIDC_ISSUER=
IDENTITY_OIDC_CLIENT_ID=
IDENTITY_OIDC_CLIENT_SECRET=
# Exact API callback registered with the provider; the path must remain /api/v1/identity/callback.
IDENTITY_OIDC_CALLBACK_URI=
# Base64url encoding of exactly 32 random bytes. Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
IDENTITY_FLOW_SEAL_KEY=
# Required with OIDC. Dedicated server-only HMAC secret for the signed provider event bridge.
IDENTITY_PROVIDER_EVENT_HMAC_SECRET=
# Scheme plus registrable-domain boundary shared by the frontend and API (for example https://matchday.example).
IDENTITY_COOKIE_SITE=
# Comma-separated exact destinations after successful sign-in; origins or wildcard paths are not accepted.
IDENTITY_POST_AUTH_REDIRECT_URIS=http://127.0.0.1:3000/organiser,http://localhost:3000/organiser
# Recovery is hosted by the identity provider because OIDC has no standard password-reset API.
IDENTITY_RECOVERY_MODE=hosted
IDENTITY_HOSTED_RECOVERY_URL=
# Authentication assurance is deliberately off until the Auth0/WebAuthn rollout has been proven.
# Supported values: off, mfa, phishing_resistant.
IDENTITY_ASSURANCE_POLICY=off
# Optional freshness requirement, 60-86400 seconds. Leave blank while policy is off.
IDENTITY_ASSURANCE_MAX_AGE_SECONDS=
# Namespaced boolean ID-token claim emitted by the Auth0 Post-Login Action after a WebAuthn factor.
# Required before enabling phishing_resistant, for example https://matchday.example/claims/phishing-resistant.
IDENTITY_OIDC_ASSURANCE_CLAIM=
# Disabled by default locally. Production requires true plus an explicit OTLP HTTP endpoint.
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_METRIC_EXPORT_INTERVAL_MS=10000
