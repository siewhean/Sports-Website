{
  "name": "@matchday/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/check-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "@matchday/ai": "workspace:*",
    "@matchday/config": "workspace:*",
    "@matchday/contracts": "workspace:*",
    "@matchday/database": "workspace:*",
    "@matchday/domain": "workspace:*",
    "@matchday/identity": "workspace:*",
    "@matchday/observability": "workspace:*",
    "@matchday/scheduler": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/core": "2.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.220.0",
    "@opentelemetry/sdk-metrics": "2.9.0",
    "@opentelemetry/sdk-node": "0.220.0",
    "@sinclair/typebox": "0.34.41",
    "fastify": "5.10.0",
    "ioredis": "5.11.1",
    "openid-client": "6.8.4",
    "postgres": "3.4.9",
    "redis": "6.1.0"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.9.0"
  }
}
