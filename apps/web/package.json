{
  "name": "@matchday/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/assert-demo-fixture-env.mjs",
    "build": "next build",
    "start": "next start",
    "check:i18n": "node scripts/check-hardcoded-user-strings.mjs --self-test",
    "lint": "pnpm check:i18n && eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run lib/*.test.ts tests/unit",
    "test:e2e": "env -u NO_COLOR playwright test --grep-invert 'visual baseline(s)?'",
    "test:a11y": "env -u NO_COLOR playwright test --grep '@a11y'",
    "test:visual": "env -u NO_COLOR playwright test --grep 'visual baseline(s)?' ${CI:+-u}"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@matchday/contracts": "workspace:*",
    "@matchday/domain": "workspace:*",
    "@matchday/feature-flags": "workspace:*",
    "@matchday/ui": "workspace:*",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "^2.0.1",
    "geist": "1.7.2",
    "gsap": "3.15.0",
    "next": "16.2.11",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
