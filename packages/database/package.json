{
  "name": "@matchday/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:check": "tsx scripts/check-migrations.ts"
  },
  "dependencies": {
    "@matchday/config": "workspace:*",
    "postgres": "3.4.9"
  }
}
