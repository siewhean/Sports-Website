# Phase 4 AI provider. `disabled` preserves the complete manual setup path.
# `stub` is deterministic and is permitted only for local/test integration and evaluation runs.
PHASE4_AI_PROVIDER=disabled
PHASE4_AI_TIMEOUT_MS=8000
PHASE4_AI_MAX_ATTEMPTS=3
PHASE4_AI_CACHE_TTL_SECONDS=86400
# JSON keyring for scoring credential and client-IP rate-limit fingerprints.
# Example: {"primary":{"version":"v1","secret":"at-least-32-random-bytes"},"verificationOnly":[]}
# Verification-only keys preserve active cooldowns during an audited rotation.
SCORING_ACCESS_RATE_LIMIT_HMAC_KEYRING=
# Required while retained C1-C4 v1 Redis keys are accepted. SHA-256 commitment
# of the deployed v1 secret using the documented C5 rotation runbook procedure.
SCORING_ACCESS_RATE_LIMIT_LEGACY_V1_MATERIAL_COMMITMENT=
# Dedicated server-only HMAC secret for low-entropy scoring fallback codes.
SCORING_ACCESS_FALLBACK_CODE_HMAC_SECRET=
